---
interface TimelineEvent {
  time: string;
  title: string;
  description?: string;
}

interface Props {
  events: TimelineEvent[];
}

const { events } = Astro.props;
---

<div class="relative mx-auto max-w-2xl">
  <!-- Vertical line -->
  <div class="absolute bottom-0 left-6 top-0 w-0.5 bg-coral/20 md:left-1/2 md:-translate-x-1/2" aria-hidden="true">
  </div>

  <ol class="relative space-y-10">
    {
      events.map((event, index) => (
        <li class="relative pl-16 md:pl-0">
          <div
            class="absolute left-4 top-1 h-5 w-5 rounded-full border-4 border-coral bg-white md:left-1/2 md:-translate-x-1/2"
            aria-hidden="true"
          />

          <div class={`md:w-[calc(50%-2rem)] ${index % 2 === 0 ? 'md:mr-auto md:text-right' : 'md:ml-auto md:text-left'}`}>
            <time class="block font-ui text-[0.85rem] font-semibold uppercase tracking-[1px] text-coral">{event.time}</time>
            <h3 class="mt-1 font-display text-[1.3rem] font-semibold text-navy">{event.title}</h3>
            {event.description && <p class="mt-1 text-text-muted">{event.description}</p>}
          </div>
        </li>
      ))
    }
  </ol>
</div>
