---
import weddingData from '../data/wedding.json';

interface Props {
  variant?: 'homepage' | 'page';
  title?: string;
  subtitle?: string;
}

const { variant = 'page', title, subtitle } = Astro.props;

// Format the wedding date
const weddingDate = new Date(weddingData.date + 'T00:00:00');
const formattedDate = weddingDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

{variant === 'homepage' ? (
  <section
    class="hero-section relative flex min-h-[90vh] flex-col items-center justify-center overflow-hidden px-6 py-20 text-center"
    aria-label="Wedding announcement"
  >
    <div class="relative z-10 mx-auto max-w-[600px]">
      <!-- Eyebrow -->
      <p class="mb-8 font-ui text-[0.9rem] font-semibold uppercase tracking-[4px] text-coral">
        &#10022; Together with their families &#10022;
      </p>

      <!-- Names -->
      <h1 class="font-display text-[clamp(3.5rem,12vw,5.5rem)] font-normal leading-[1.15] text-navy">
        {weddingData.couple.person1}
        <span class="my-[0.3em] block text-[0.5em] italic text-coral">&amp;</span>
        {weddingData.couple.person2}
      </h1>

      <!-- Tagline -->
      <p class="mt-4 font-ui text-[1rem] font-medium uppercase tracking-[4px] text-text-muted">
        Request your presence
      </p>

      <!-- Photo placeholder -->
      <div class="mx-auto mt-10 flex h-[220px] w-[320px] items-center justify-center rounded-2xl bg-gradient-to-br from-coral-bright to-salmon text-white shadow-[0_20px_40px_rgba(249,104,84,0.2)]">
        <p class="px-6 font-ui text-[0.9rem] font-medium">[Your engagement photo here]</p>
      </div>

      <!-- Date & Location -->
      <div class="mt-8">
        <p class="font-display text-[1.5rem] font-semibold text-navy">{formattedDate}</p>
        <p class="mt-2 text-[0.9rem] uppercase tracking-[2px] text-text-muted">Fulton Market, Chicago</p>
      </div>

      <!-- CTA -->
      <a
        href="/details"
        class="mt-10 inline-block rounded-full bg-coral px-8 py-4 font-ui text-[0.95rem] font-semibold uppercase tracking-[1px] text-white shadow-[0_4px_20px_rgba(249,104,84,0.25)] transition-all hover:-translate-y-0.5 hover:bg-coral-dark hover:shadow-[0_6px_25px_rgba(249,104,84,0.3)]"
      >
        View Details <span class="ml-2 inline-block">&#8594;</span>
      </a>
    </div>
  </section>
) : (
  <section class="px-6 pb-8 pt-12 text-center" aria-label="Page header">
    <h1 class="font-display text-[2.5rem] font-normal text-navy">{title}</h1>
    {subtitle && <p class="mt-3 text-text-muted">{subtitle}</p>}
  </section>
)}

<style>
  .hero-section::before {
    content: '';
    position: absolute;
    top: -20%;
    right: -15%;
    width: 500px;
    height: 500px;
    background: linear-gradient(135deg, var(--color-coral-bright) 0%, var(--color-salmon) 100%);
    border-radius: 50%;
    opacity: 0.06;
    z-index: 0;
  }

  .hero-section::after {
    content: '';
    position: absolute;
    bottom: -25%;
    left: -10%;
    width: 400px;
    height: 400px;
    background: linear-gradient(135deg, var(--color-salmon) 0%, var(--color-coral) 100%);
    border-radius: 50%;
    opacity: 0.05;
    z-index: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-section::before,
    .hero-section::after {
      display: none;
    }
  }
</style>
