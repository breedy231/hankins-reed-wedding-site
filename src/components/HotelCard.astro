---
interface Props {
  name: string;
  address: string;
  priceRange: string;
  distance: string;
  bookingUrl?: string;
  blockCode?: string;
  blockDeadline?: string;
}

const { name, address, priceRange, distance, bookingUrl, blockCode, blockDeadline } = Astro.props;
---

<article class="flex flex-col rounded-2xl border-2 border-transparent bg-white p-8 transition-all hover:-translate-y-1 hover:border-coral hover:shadow-[0_12px_35px_rgba(249,104,84,0.12)]">
  <h3 class="font-display text-[1.3rem] font-semibold text-navy">{name}</h3>

  <address class="mt-2 not-italic text-text-muted">{address}</address>

  <div class="mt-4 flex flex-wrap gap-3">
    <span class="inline-flex items-center rounded-full bg-light-cream px-3 py-1 font-ui text-[0.8rem] font-semibold text-coral-dark">
      {priceRange}
    </span>
    <span class="inline-flex items-center rounded-full bg-light-cream px-3 py-1 font-ui text-[0.8rem] text-navy">
      {distance} from venue
    </span>
  </div>

  {
    blockCode && (
      <div class="mt-4 rounded-xl bg-light-cream p-4">
        <p class="font-ui text-[0.85rem] font-semibold text-coral-dark">Room Block Code: {blockCode}</p>
        {blockDeadline && <p class="mt-1 text-[0.85rem] text-coral">Book by {blockDeadline} for group rate</p>}
      </div>
    )
  }

  <div class="mt-auto pt-6">
    {
      bookingUrl ? (
        <a
          href={bookingUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="touch-target inline-block rounded-full bg-coral px-6 py-3 font-ui text-[0.85rem] font-semibold uppercase tracking-[1px] text-white transition-all hover:-translate-y-0.5 hover:bg-coral-dark"
        >
          Book Now
          <span class="sr-only">(opens in new tab)</span>
        </a>
      ) : (
        <span class="text-[0.9rem] text-text-muted">Booking link coming soon</span>
      )
    }
  </div>
</article>
