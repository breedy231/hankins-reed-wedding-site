---
interface Props {
  name: string;
  address: string;
  priceRange: string;
  distance: string;
  bookingUrl?: string;
  blockCode?: string;
  blockDeadline?: string;
}

const { name, address, priceRange, distance, bookingUrl, blockCode, blockDeadline } = Astro.props;
---

<article class="flex flex-col rounded-lg border border-neutral-200 bg-white p-6 shadow-sm">
  <h3 class="text-xl font-semibold text-neutral-900">{name}</h3>

  <address class="mt-2 not-italic text-neutral-600">{address}</address>

  <div class="mt-4 flex flex-wrap gap-3">
    <span class="inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-sm text-primary-700">
      {priceRange}
    </span>
    <span class="inline-flex items-center rounded-full bg-neutral-100 px-3 py-1 text-sm text-neutral-700">
      {distance} from venue
    </span>
  </div>

  {
    blockCode && (
      <div class="mt-4 rounded-md bg-primary-50 p-3">
        <p class="text-sm font-medium text-primary-700">Room Block Code: {blockCode}</p>
        {blockDeadline && <p class="mt-1 text-sm text-primary-600">Book by {blockDeadline} for group rate</p>}
      </div>
    )
  }

  <div class="mt-auto pt-4">
    {
      bookingUrl ? (
        <a
          href={bookingUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="touch-target inline-flex items-center gap-2 rounded-md bg-primary-500 px-4 py-2 text-white transition-colors hover:bg-primary-600 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
        >
          Book Now
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          <span class="sr-only">(opens in new tab)</span>
        </a>
      ) : (
        <span class="text-sm text-neutral-500">Booking link coming soon</span>
      )
    }
  </div>
</article>
