---
interface AccordionItem {
  question: string;
  answer: string;
}

interface Props {
  items: AccordionItem[];
}

const { items } = Astro.props;
---

<div class="accordion space-y-4">
  {
    items.map((item, index) => (
      <div class="accordion-item rounded-lg border border-light-gray bg-white">
        <h3>
          <button
            type="button"
            class="touch-target flex w-full items-center justify-between gap-4 px-6 py-4 text-left font-semibold text-navy transition-colors hover:bg-cream focus:outline-none focus:ring-2 focus:ring-inset focus:ring-coral"
            aria-expanded="false"
            aria-controls={`accordion-panel-${index}`}
            id={`accordion-trigger-${index}`}
          >
            <span>{item.question}</span>
            <svg
              class="accordion-icon h-5 w-5 flex-shrink-0 text-coral transition-transform duration-200"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </h3>
        <div
          id={`accordion-panel-${index}`}
          role="region"
          aria-labelledby={`accordion-trigger-${index}`}
          class="accordion-panel"
          hidden
        >
          <div class="px-6 pb-4 text-navy">
            <p set:html={item.answer} />
          </div>
        </div>
      </div>
    ))
  }
</div>

<style>
  .accordion-item button[aria-expanded='true'] .accordion-icon {
    transform: rotate(180deg);
  }

  .accordion-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 200ms ease-out;
  }

  .accordion-panel[hidden] {
    display: grid;
  }

  .accordion-panel:not([hidden]) {
    grid-template-rows: 1fr;
  }

  .accordion-panel > div {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion-icon,
    .accordion-panel {
      transition: none;
    }
  }
</style>

<script>
  function initAccordion() {
    const accordions = document.querySelectorAll('.accordion');

    accordions.forEach((accordion) => {
      const buttons = accordion.querySelectorAll('button[aria-expanded]');

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const expanded = button.getAttribute('aria-expanded') === 'true';
          const panelId = button.getAttribute('aria-controls');
          const panel = panelId ? document.getElementById(panelId) : null;

          if (panel) {
            button.setAttribute('aria-expanded', (!expanded).toString());
            panel.hidden = expanded;
          }
        });

        // Keyboard navigation
        button.addEventListener('keydown', (event) => {
          const items = Array.from(accordion.querySelectorAll('button[aria-expanded]'));
          const currentIndex = items.indexOf(button as Element);
          let targetIndex = -1;

          if (event instanceof KeyboardEvent) {
            switch (event.key) {
              case 'ArrowDown':
                event.preventDefault();
                targetIndex = (currentIndex + 1) % items.length;
                break;
              case 'ArrowUp':
                event.preventDefault();
                targetIndex = (currentIndex - 1 + items.length) % items.length;
                break;
              case 'Home':
                event.preventDefault();
                targetIndex = 0;
                break;
              case 'End':
                event.preventDefault();
                targetIndex = items.length - 1;
                break;
            }
          }

          if (targetIndex >= 0 && items[targetIndex] instanceof HTMLElement) {
            (items[targetIndex] as HTMLElement).focus();
          }
        });
      });
    });
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAccordion);
  } else {
    initAccordion();
  }
</script>
