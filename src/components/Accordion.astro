---
interface AccordionItem {
  question: string;
  answer: string;
}

interface Props {
  items: AccordionItem[];
}

const { items } = Astro.props;
---

<div class="accordion space-y-4">
  {
    items.map((item) => (
      <details class="faq-item group rounded-2xl border-2 border-navy/10 bg-white transition-all hover:border-coral hover:shadow-[0_4px_15px_rgba(107,143,194,0.1)]">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-ui text-[1rem] font-semibold text-navy [&::-webkit-details-marker]:hidden">
          <span>{item.question}</span>
          <span class="faq-icon flex h-6 w-6 flex-shrink-0 items-center justify-center text-[1.25rem] text-coral transition-transform" aria-hidden="true">
            <span class="group-open:hidden">+</span>
            <span class="hidden group-open:inline">&minus;</span>
          </span>
        </summary>
        <div class="px-6 pb-5">
          <p class="font-body leading-[1.7] text-text-muted" set:html={item.answer} />
        </div>
      </details>
    ))
  }
</div>

<style>
  details[open] {
    border-color: var(--color-coral);
    background: linear-gradient(to bottom, white, var(--color-light-cream));
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-icon {
      transition: none;
    }
  }
</style>
