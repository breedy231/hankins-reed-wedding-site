---
interface Props {
  name: string;
  type: 'ceremony' | 'reception';
  address: string;
  time?: string;
}

const { name, type, address, time } = Astro.props;

// Generate Google Maps link from address
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;

const typeLabel = type === 'ceremony' ? 'Ceremony' : 'Reception';
---

<article class="rounded-lg border border-light-gray bg-white p-6 shadow-sm">
  <div class="mb-2 inline-block rounded-full bg-light-cream px-3 py-1 text-sm font-medium text-coral-dark">
    {typeLabel}
  </div>

  <h3 class="mt-2 text-xl font-semibold text-navy">{name}</h3>

  {time && <p class="mt-1 text-coral">{time}</p>}

  <address class="mt-3 not-italic text-text-muted">
    {address}
  </address>

  <a
    href={mapsUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="touch-target mt-4 inline-flex items-center gap-2 rounded-full bg-coral px-4 py-2 font-ui text-white transition-colors hover:bg-coral-dark focus:outline-none focus:ring-2 focus:ring-coral focus:ring-offset-2"
  >
    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
    </svg>
    View on Map
    <span class="sr-only">(opens in new tab)</span>
  </a>
</article>
