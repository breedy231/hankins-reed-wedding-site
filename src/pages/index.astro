---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Countdown from '../components/Countdown.astro';
---

<BaseLayout title="Home" description="Join us to celebrate our wedding">
  <Navigation slot="header" />

  <Hero />

  <Countdown />

  <!-- Welcome Message -->
  <section class="mx-auto max-w-2xl px-4 py-16 text-center">
    <h2 class="font-display text-2xl text-neutral-900 md:text-3xl">We can't wait to celebrate with you!</h2>
    <p class="mt-4 text-neutral-700">
      Please explore this site for all the details about our wedding day, travel information, and more. We're so
      excited to have you join us.
    </p>
  </section>

  <Footer slot="footer" />
</BaseLayout>
