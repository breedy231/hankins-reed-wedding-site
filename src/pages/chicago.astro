---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import chicagoData from '../data/chicago.json';
---

<BaseLayout title="Chicago" description="Our favorite Chicago restaurants, activities, and neighborhoods to explore">
  <Navigation slot="header" />

  <Hero title="Our Chicago" subtitle="Our favorite spots in the city" />

  <!-- Restaurants -->
  <section class="px-6 py-24" aria-labelledby="restaurants-heading">
    <div class="mx-auto max-w-4xl">
      <h2 id="restaurants-heading" class="mb-12 text-center font-display text-[2.2rem] font-normal text-navy">Where to Eat</h2>

      <p class="mx-auto mb-10 max-w-2xl text-center text-text-muted">If you want to see some of our story together, here are restaurants we've been to multiple times</p>

      <div class="grid gap-6 md:grid-cols-2">
        {
          chicagoData.restaurants.map((restaurant) => (
            <article class="rounded-2xl border-2 border-transparent bg-white p-8 transition-all hover:-translate-y-1 hover:border-coral hover:shadow-[0_12px_35px_rgba(107,143,194,0.12)]">
              <div class="flex items-start justify-between gap-4">
                <h3 class="font-display text-[1.3rem] font-semibold text-navy">{restaurant.name}</h3>
                <span class="flex-shrink-0 rounded-full bg-light-cream px-3 py-1 font-ui text-[0.75rem] font-semibold uppercase tracking-[1px] text-coral-dark">
                  {restaurant.cuisine}
                </span>
              </div>
              <p class="mt-3 text-text-muted">{restaurant.description}</p>
              <div class="mt-4 font-ui text-[0.8rem] text-text-muted">
                <span>{restaurant.neighborhood}</span>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Activities -->
  <section class="bg-light-cream px-6 py-24" aria-labelledby="activities-heading">
    <div class="mx-auto max-w-4xl">
      <h2 id="activities-heading" class="mb-12 text-center font-display text-[2.2rem] font-normal text-navy">What to Do</h2>

      <div class="grid gap-6 md:grid-cols-2">
        {
          chicagoData.activities.map((activity) => (
            <article class="rounded-2xl border-2 border-transparent bg-white p-8 transition-all hover:-translate-y-1 hover:border-coral hover:shadow-[0_12px_35px_rgba(107,143,194,0.12)]">
              <div class="flex items-start justify-between gap-4">
                <h3 class="font-display text-[1.3rem] font-semibold text-navy">{activity.name}</h3>
                <span class="flex-shrink-0 rounded-full bg-light-cream px-3 py-1 font-ui text-[0.75rem] font-semibold uppercase tracking-[1px] text-coral-dark">
                  {activity.type}
                </span>
              </div>
              <p class="mt-3 text-text-muted">{activity.description}</p>
              <div class="mt-4 flex flex-wrap gap-4 font-ui text-[0.8rem] text-text-muted">
                <span>{activity.duration}</span>
                <span>{activity.bestFor}</span>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Neighborhoods -->
  <section class="px-6 py-24" aria-labelledby="neighborhoods-heading">
    <div class="mx-auto max-w-4xl">
      <h2 id="neighborhoods-heading" class="mb-12 text-center font-display text-[2.2rem] font-normal text-navy">
        Neighborhoods to Explore
      </h2>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          chicagoData.neighborhoods.map((hood) => (
            <article class="rounded-2xl border-2 border-transparent bg-white p-8 transition-all hover:-translate-y-1 hover:border-coral hover:shadow-[0_12px_35px_rgba(107,143,194,0.12)]">
              <h3 class="font-display text-[1.3rem] font-semibold text-navy">{hood.name}</h3>
              <p class="mt-1 font-ui text-[0.85rem] font-semibold text-coral">{hood.vibe}</p>
              <p class="mt-3 text-text-muted">{hood.description}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {hood.highlights.map((highlight) => (
                  <li class="rounded-full bg-light-cream px-3 py-1 font-ui text-[0.75rem] text-text-muted">{highlight}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Local Tips -->
  <section class="bg-light-cream px-6 py-24" aria-labelledby="tips-heading">
    <div class="mx-auto max-w-2xl">
      <h2 id="tips-heading" class="mb-8 text-center font-display text-[2.2rem] font-normal text-navy">Insider Tips</h2>

      <ul class="space-y-4">
        <li class="flex items-start gap-3 text-navy">
          <span class="mt-0.5 text-coral">&#10003;</span>
          <span><strong>Get a Ventra card</strong> for easy CTA access. The trains are the fastest way around the city.</span>
        </li>
        <li class="flex items-start gap-3 text-navy">
          <span class="mt-0.5 text-coral">&#10003;</span>
          <span><strong>Architecture boat tours</strong> book up fast in summer — reserve ahead!</span>
        </li>
        <li class="flex items-start gap-3 text-navy">
          <span class="mt-0.5 text-coral">&#10003;</span>
          <span><strong>Deep dish debate:</strong> Lou Malnati's vs Pequod's. Try both and pick your side.</span>
        </li>
        <li class="flex items-start gap-3 text-navy">
          <span class="mt-0.5 text-coral">&#10003;</span>
          <span><strong>August weather</strong> can be unpredictable. Bring layers and an umbrella just in case.</span>
        </li>
      </ul>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
