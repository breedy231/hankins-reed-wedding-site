---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import chicagoData from '../data/chicago.json';
---

<BaseLayout title="Things To Do" description="Our favorite Chicago restaurants, activities, and neighborhoods to explore">
  <Navigation slot="header" />

  <!-- Page Header -->
  <section class="bg-gradient-to-b from-light-cream to-white px-4 py-12 text-center">
    <h1 class="font-display text-4xl text-navy md:text-5xl">Things To Do in Chicago</h1>
    <p class="mt-4 text-text-muted">Make a weekend of it! Here are some of our favorite spots.</p>
  </section>

  <!-- Restaurants -->
  <section class="px-4 py-12" aria-labelledby="restaurants-heading">
    <div class="mx-auto max-w-4xl">
      <h2 id="restaurants-heading" class="mb-8 text-center font-display text-3xl text-navy">Where to Eat</h2>

      <div class="grid gap-6 md:grid-cols-2">
        {
          chicagoData.restaurants.map((restaurant) => (
            <article class="rounded-lg border border-light-gray bg-white p-6 shadow-sm">
              <div class="flex items-start justify-between">
                <h3 class="text-xl font-semibold text-navy">{restaurant.name}</h3>
                <span class="text-sm font-medium text-coral">{restaurant.priceRange}</span>
              </div>
              <p class="mt-1 text-sm text-coral">{restaurant.cuisine} · {restaurant.neighborhood}</p>
              <p class="mt-3 text-text-muted">{restaurant.description}</p>
              {restaurant.reservations && (
                <p class="mt-3 text-sm text-text-muted">
                  <span class="inline-flex items-center gap-1">
                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
                    </svg>
                    Reservations recommended
                  </span>
                </p>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Activities -->
  <section class="bg-light-cream px-4 py-12" aria-labelledby="activities-heading">
    <div class="mx-auto max-w-4xl">
      <h2 id="activities-heading" class="mb-8 text-center font-display text-3xl text-navy">What to Do</h2>

      <div class="grid gap-6 md:grid-cols-2">
        {
          chicagoData.activities.map((activity) => (
            <article class="rounded-lg border border-light-gray bg-white p-6 shadow-sm">
              <div class="flex items-start justify-between">
                <h3 class="text-xl font-semibold text-navy">{activity.name}</h3>
                <span class="rounded-full bg-light-cream px-3 py-1 text-xs font-medium text-coral-dark">
                  {activity.type}
                </span>
              </div>
              <p class="mt-3 text-text-muted">{activity.description}</p>
              <div class="mt-4 flex flex-wrap gap-4 text-sm text-text-muted">
                <span class="flex items-center gap-1">
                  <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                  </svg>
                  {activity.duration}
                </span>
                <span class="flex items-center gap-1">
                  <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z" />
                  </svg>
                  {activity.bestFor}
                </span>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Neighborhoods -->
  <section class="px-4 py-12" aria-labelledby="neighborhoods-heading">
    <div class="mx-auto max-w-4xl">
      <h2 id="neighborhoods-heading" class="mb-8 text-center font-display text-3xl text-navy">
        Neighborhoods to Explore
      </h2>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          chicagoData.neighborhoods.map((hood) => (
            <article class="rounded-lg border border-light-gray bg-white p-6 shadow-sm">
              <h3 class="text-xl font-semibold text-navy">{hood.name}</h3>
              <p class="mt-1 text-sm font-medium text-coral">{hood.vibe}</p>
              <p class="mt-3 text-text-muted">{hood.description}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {hood.highlights.map((highlight) => (
                  <li class="rounded-full bg-light-cream px-3 py-1 text-xs text-text-muted">{highlight}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Pro Tips -->
  <section class="bg-light-cream px-4 py-12" aria-labelledby="tips-heading">
    <div class="mx-auto max-w-2xl">
      <h2 id="tips-heading" class="mb-6 text-center font-display text-3xl text-navy">Local Tips</h2>

      <ul class="space-y-4">
        <li class="flex items-start gap-3">
          <svg class="mt-1 h-5 w-5 flex-shrink-0 text-coral" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"
            />
          </svg>
          <span class="text-navy"
            ><strong>Get a Ventra card</strong> for easy CTA access. The trains are the fastest way around the city.</span
          >
        </li>
        <li class="flex items-start gap-3">
          <svg class="mt-1 h-5 w-5 flex-shrink-0 text-coral" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"
            />
          </svg>
          <span class="text-navy"
            ><strong>Architecture boat tours</strong> book up fast in summer - reserve ahead!</span
          >
        </li>
        <li class="flex items-start gap-3">
          <svg class="mt-1 h-5 w-5 flex-shrink-0 text-coral" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"
            />
          </svg>
          <span class="text-navy"
            ><strong>Deep dish debate:</strong> Lou Malnati's vs Pequod's. Try both and pick your side!</span
          >
        </li>
        <li class="flex items-start gap-3">
          <svg class="mt-1 h-5 w-5 flex-shrink-0 text-coral" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"
            />
          </svg>
          <span class="text-navy"
            ><strong>Summer weather</strong> can be unpredictable. Bring layers and an umbrella just in case.</span
          >
        </li>
      </ul>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
