---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import weddingData from '../data/wedding.json';
---

<BaseLayout title="Our Story" description="The story of how we met and fell in love">
  <Navigation slot="header" />

  <Hero title="Our Story" subtitle="How it all began" />

  <!-- Photo placeholder -->
  <section class="px-6 py-12">
    <div class="mx-auto max-w-2xl">
      <div
        class="flex aspect-[4/3] items-center justify-center rounded-2xl bg-gradient-to-br from-coral to-salmon"
        role="img"
        aria-label="Photo of the couple coming soon"
      >
        <p class="font-ui text-[0.9rem] font-medium text-white">[Engagement photo coming soon]</p>
      </div>
    </div>
  </section>

  <!-- Story content -->
  <section class="px-6 py-12" aria-labelledby="story-heading">
    <div class="mx-auto max-w-2xl">
      <h2 id="story-heading" class="sr-only">Our Love Story</h2>

      <div class="space-y-12">
        <div>
          <h3 class="font-display text-[1.8rem] font-normal text-navy">How We Met</h3>
          <p class="mt-4 leading-[1.7] text-navy">
            Our story is still being written... Check back soon to hear all about how
            <span class="font-semibold">{weddingData.couple.person1}</span> and
            <span class="font-semibold">{weddingData.couple.person2}</span> found each other!
          </p>
        </div>

        <blockquote class="rounded-2xl border-l-4 border-coral bg-light-cream p-8">
          <p class="font-display text-[1.3rem] italic text-navy">
            "Insert your favorite quote about love here, or a meaningful quote from your relationship."
          </p>
        </blockquote>

        <div>
          <h3 class="font-display text-[1.8rem] font-normal text-navy">The Proposal</h3>
          <p class="mt-4 leading-[1.7] text-navy">
            Details about the proposal coming soon! We can't wait to share this special moment with you.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- More photos placeholder -->
  <section class="bg-light-cream px-6 py-24" aria-labelledby="photos-heading">
    <div class="mx-auto max-w-4xl">
      <h2 id="photos-heading" class="mb-12 text-center font-display text-[2.2rem] font-normal text-navy">Moments Together</h2>

      <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3">
        {
          [1, 2, 3].map((i) => (
            <div
              class="flex aspect-square items-center justify-center rounded-2xl bg-gradient-to-br from-coral/20 to-salmon/20"
              role="img"
              aria-label={`Photo ${i} coming soon`}
            >
              <svg
                class="h-12 w-12 text-coral/40"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"
                />
              </svg>
            </div>
          ))
        }
      </div>

      <p class="mt-8 text-center text-text-muted">More photos coming soon!</p>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
