---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="RSVP" description="RSVP for Brendan & Scott's wedding">
  <Navigation slot="header" />

  <Hero title="RSVP" subtitle="We can't wait to celebrate with you" />

  <!-- RSVP content -->
  <section class="px-6 py-24" aria-labelledby="rsvp-heading">
    <div class="mx-auto max-w-xl text-center">
      <h2 id="rsvp-heading" class="sr-only">RSVP Information</h2>

      <!-- Status message -->
      <p class="font-display text-[1.5rem] font-semibold text-navy">
        RSVP will open in Spring 2026
      </p>
      <p class="mt-4 leading-[1.7] text-text-muted">
        When RSVPs open, you'll be able to respond right here. We'll send details in your invitation.
      </p>

      <!-- Placeholder for future RSVP embed -->
      <!-- RSVP_EMBED_HERE -->
      <div class="mt-10 rounded-2xl border-2 border-dashed border-coral-bright/30 p-12">
        <svg
          class="mx-auto h-12 w-12 text-coral-bright/40"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
          />
        </svg>
        <p class="mt-4 font-ui text-[0.9rem] font-medium text-text-muted">
          RSVP form coming soon
        </p>
      </div>

      <!-- Deadline reminder -->
      <p class="mt-10 font-ui text-[0.9rem] font-semibold uppercase tracking-[2px] text-coral">
        Please respond by July 1, 2026
      </p>

      <!-- Contact fallback -->
      <p class="mt-6 text-text-muted">
        Having trouble? Email us at
        <a href="mailto:wedding@reedwedding.com" class="text-coral transition-colors hover:text-coral-dark hover:underline">
          wedding@reedwedding.com
        </a>
      </p>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
