---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import guestsData from '../data/guests.json';
import mealsData from '../data/meals.json';

const schedule = [
  { time: '6:00 PM', title: 'Cocktail Hour', description: 'Drinks, bites, and mingling' },
  { time: '7:30 PM', title: 'Dinner', description: 'Seated dinner' },
  { time: '9:00 PM', title: 'Dancing', description: 'Dance the night away until midnight' },
];
---

<BaseLayout title="RSVP" description="RSVP for Brendan & Scott's wedding">
  <Navigation slot="header" />

  <Hero title="RSVP" subtitle="We can't wait to celebrate with you" />

  <!-- Schedule -->
  <section class="bg-light-cream px-6 py-24" aria-labelledby="schedule-heading">
    <div class="mx-auto max-w-4xl text-center">
      <p class="font-ui text-[0.8rem] font-semibold uppercase tracking-[3px] text-coral">August 22, 2026</p>
      <h2 id="schedule-heading" class="mt-4 font-display text-[2.2rem] font-normal text-navy">Schedule</h2>
      <p class="mx-auto mt-4 max-w-lg text-pretty text-navy">We want you there at 6 to get the party started.</p>
    </div>
    <div class="mx-auto mt-12 max-w-4xl">
      <Timeline events={schedule} />
    </div>
  </section>

  <!-- Transport -->
  <section class="px-6 py-24" aria-labelledby="rsvp-transport-heading">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="rsvp-transport-heading" class="font-display text-[2.2rem] font-normal text-navy">Getting There & Home</h2>
      <p class="mx-auto mt-4 max-w-lg text-pretty text-navy">
        Get yourself there! We recommend rideshare (Uber/Lyft) or CTA. We'll have shuttles running back to the hotel blocks all evening to get you home.
      </p>
    </div>
  </section>

  <section class="bg-light-cream px-6 py-16" aria-labelledby="rsvp-heading">
    <div class="mx-auto max-w-xl">
      <h2 id="rsvp-heading" class="sr-only">RSVP Form</h2>

      {mealsData.rsvpEnabled ? (
        <>
          <p class="mb-10 text-center font-ui text-[0.9rem] font-semibold uppercase tracking-[2px] text-coral">
            Please respond by July 1, 2026
          </p>

          <div id="password-gate">
            <label for="rsvp-password" class="mb-2 block font-display text-[1.25rem] font-semibold text-navy">
              Enter the code to RSVP
            </label>
            <p class="mb-4 text-text-muted">Check your invitation for the code.</p>
            <div class="flex gap-3">
              <input
                id="rsvp-password"
                type="password"
                placeholder="Code"
                class="flex-1 rounded-xl border-2 border-light-gray bg-white px-5 py-4 font-body text-[1rem] text-navy placeholder:text-text-muted/60 focus:border-coral focus:outline-none"
              />
              <button
                id="password-submit"
                type="button"
                class="rounded-xl bg-coral px-6 py-4 font-ui text-[0.95rem] font-semibold text-white transition-all hover:bg-coral-dark"
              >
                Enter
              </button>
            </div>
            <p id="password-error" class="mt-2 hidden text-[0.9rem] text-red-600">Incorrect code. Please try again.</p>
          </div>

          <div
            id="rsvp-app"
            class="hidden"
            data-households={JSON.stringify(guestsData.households)}
            data-meals={JSON.stringify(mealsData.meals)}
            data-deadline={mealsData.deadline}
          >
            <div id="step-lookup">
              <label id="search-label" for="guest-search" class="mb-2 block font-display text-[1.25rem] font-semibold text-navy">
                Find your name
              </label>
              <p class="mb-2 text-text-muted">Type any name from your invitation.</p>
              <div class="relative">
                <input
                  id="guest-search"
                  type="text"
                  role="combobox"
                  aria-autocomplete="list"
                  aria-expanded="false"
                  aria-controls="guest-listbox"
                  aria-labelledby="search-label"
                  autocomplete="off"
                  placeholder="Start typing your name..."
                  class="w-full rounded-xl border-2 border-light-gray bg-white px-5 py-4 font-body text-[1rem] text-navy placeholder:text-text-muted/60 focus:border-coral focus:outline-none"
                />
                <ul
                  id="guest-listbox"
                  role="listbox"
                  aria-labelledby="search-label"
                  class="absolute left-0 right-0 z-10 mt-1 hidden max-h-60 overflow-y-auto rounded-xl border border-light-gray bg-white shadow-lg"
                ></ul>
              </div>
            </div>

            <div id="step-respond" class="hidden">
              <p class="mb-2 font-display text-[1.25rem] font-semibold text-navy">
                Hi, <span id="household-display-name" class="text-coral"></span>!
              </p>
              <p class="mb-6 text-text-muted">Let us know who can make it. Mark each person as attending or not. Meal choices appear once you mark someone as attending.</p>

              <div id="member-rows" class="space-y-4"></div>

              <div class="mt-6">
                <label for="dietary-needs" class="mb-2 block font-ui text-[0.9rem] font-semibold text-navy">Dietary restrictions or allergies <span class="font-normal text-text-muted">(optional)</span></label>
                <textarea id="dietary-needs" rows="2" placeholder="e.g., nut allergy, gluten-free" class="w-full rounded-xl border-2 border-light-gray bg-white px-5 py-4 font-body text-[1rem] text-navy placeholder:text-text-muted/60 focus:border-coral focus:outline-none"></textarea>
              </div>

              <div class="mt-6">
                <label for="note" class="mb-2 block font-ui text-[0.9rem] font-semibold text-navy">A note for the couple <span class="font-normal text-text-muted">(optional)</span></label>
                <textarea id="note" rows="2" placeholder="Well wishes, etc." class="w-full rounded-xl border-2 border-light-gray bg-white px-5 py-4 font-body text-[1rem] text-navy placeholder:text-text-muted/60 focus:border-coral focus:outline-none"></textarea>
              </div>

              <p id="validation-summary" class="mt-4 hidden rounded-lg border border-red-300 bg-red-50 p-3 text-[0.9rem] text-red-700" role="alert"></p>

              <button id="submit-rsvp" type="button" class="mt-8 flex w-full min-h-14 items-center justify-center rounded-full bg-coral px-8 py-4 font-ui text-[0.95rem] font-semibold uppercase tracking-[1px] text-white shadow-[0_4px_20px_rgba(74,111,165,0.25)] transition-all hover:-translate-y-0.5 hover:bg-coral-dark hover:shadow-[0_6px_25px_rgba(74,111,165,0.3)] disabled:opacity-50 disabled:hover:translate-y-0">Send RSVP</button>
            </div>

            <div id="step-success" class="hidden text-center">
              <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-coral/10">
                <svg class="h-8 w-8 text-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
              </div>
              <p class="font-display text-[1.5rem] font-semibold text-navy" id="success-heading">Thank you!</p>
              <p class="mt-2 text-text-muted" id="success-message"></p>

              <div id="dance-reveal" class="mt-12 hidden">
                <div class="mx-auto max-w-md">
                  <p class="font-ui text-[0.8rem] font-semibold uppercase tracking-[3px] text-coral">One more thing</p>
                  <h3 class="mt-3 font-display text-[1.75rem] font-normal text-navy">Learn the dance</h3>
                  <p class="mx-auto mt-3 text-pretty text-text-muted">
                    We're teaching everyone a little something for the reception. Practice along, no pressure, just fun.
                  </p>
                  <div class="mx-auto mt-6 aspect-[9/16] w-full max-w-xs overflow-hidden rounded-2xl bg-navy/5 shadow-[0_8px_30px_rgba(13,18,64,0.15)]">
                    <video
                      id="dance-video"
                      class="h-full w-full object-cover"
                      controls
                      playsinline
                      preload="metadata"
                      poster="/videos/dance-poster.jpg"
                    >
                      <source src="/videos/dance.mp4" type="video/mp4" />
                      Your browser doesn't support embedded video.
                      <a href="/videos/dance.mp4" class="text-coral underline">Download the video</a> instead.
                    </video>
                  </div>
                  <p class="mt-4 text-[0.9rem] text-text-muted">
                    No rush. You can always find this video later in the <a href="/details" class="text-primary underline underline-offset-2">Details</a> section.
                  </p>
                </div>
              </div>
            </div>

            <div id="step-error" class="hidden">
              <div class="rounded-xl border-2 border-red-300 bg-red-50 p-6 text-center">
                <p class="font-ui text-[0.95rem] font-semibold text-red-700">Something went wrong</p>
                <p class="mt-1 text-[0.9rem] text-red-600" id="error-message"></p>
                <button id="retry-btn" type="button" class="mt-4 inline-flex min-h-12 items-center justify-center rounded-full bg-red-600 px-6 py-3 font-ui text-[0.9rem] font-semibold text-white transition-colors hover:bg-red-700">Try Again</button>
              </div>
            </div>

            <div id="step-closed" class="hidden text-center">
              <p class="font-display text-[1.5rem] font-semibold text-navy">RSVPs are closed</p>
              <p class="mt-4 text-text-muted">
                The deadline has passed. Please contact us directly at
                <a href="mailto:hankinsreedwedding@protonmail.com" class="text-coral hover:text-coral-dark hover:underline">hankinsreedwedding@protonmail.com</a>
              </p>
            </div>
          </div>

          <p class="mt-10 text-center text-text-muted">
            Having trouble? Email us at
            <a href="mailto:hankinsreedwedding@protonmail.com" class="text-coral transition-colors hover:text-coral-dark hover:underline">hankinsreedwedding@protonmail.com</a>
          </p>
        </>
      ) : (
        <div class="py-12 text-center">
          <p class="font-display text-[1.5rem] font-semibold text-navy">RSVP Coming Soon</p>
          <p class="mx-auto mt-4 max-w-md text-text-muted">
            RSVP will open soon. Check back after you receive your invitation!
          </p>
        </div>
      )}
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  import {
    attendingCount,
    decliningCount,
    findHouseholds,
    initFormState,
    setAttendance,
    setMeal,
    toSubmitPayload,
    validate,
    type Household,
    type MemberFormState,
  } from '../lib/rsvp';

  // Password gate
  const passwordGate = document.getElementById('password-gate');
  const passwordInput = document.getElementById('rsvp-password') as HTMLInputElement | null;
  const passwordSubmit = document.getElementById('password-submit');
  const passwordError = document.getElementById('password-error');
  const app = document.getElementById('rsvp-app');

  if (passwordGate && passwordInput && passwordSubmit && app) {
    const SITE_PASSWORD = 'disco';

    function checkPassword() {
      if (passwordInput!.value.toLowerCase().trim() === SITE_PASSWORD) {
        passwordGate!.classList.add('hidden');
        app!.classList.remove('hidden');
      } else {
        passwordError?.classList.remove('hidden');
        passwordInput!.classList.add('border-red-400');
      }
    }

    passwordSubmit.addEventListener('click', checkPassword);
    passwordInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') checkPassword();
    });
  }

  if (!app) throw new Error('RSVP app not found');
  const HOUSEHOLDS: Household[] = JSON.parse(app.dataset.households!);
  const MEALS: { id: string; label: string }[] = JSON.parse(app.dataset.meals!);
  const DEADLINE = app.dataset.deadline!;

  // Elements
  const stepLookup = document.getElementById('step-lookup')!;
  const stepRespond = document.getElementById('step-respond')!;
  const stepSuccess = document.getElementById('step-success')!;
  const stepError = document.getElementById('step-error')!;
  const stepClosed = document.getElementById('step-closed')!;

  const searchInput = document.getElementById('guest-search') as HTMLInputElement;
  const listbox = document.getElementById('guest-listbox')!;
  const householdDisplayName = document.getElementById('household-display-name')!;
  const memberRows = document.getElementById('member-rows')!;
  const submitBtn = document.getElementById('submit-rsvp') as HTMLButtonElement;
  const validationSummary = document.getElementById('validation-summary')!;
  const successHeading = document.getElementById('success-heading')!;
  const successMessage = document.getElementById('success-message')!;
  const danceReveal = document.getElementById('dance-reveal')!;
  const errorMessage = document.getElementById('error-message')!;
  const retryBtn = document.getElementById('retry-btn')!;

  let selectedHousehold: Household | null = null;
  let formState: MemberFormState[] = [];
  let activeIndex = -1;

  // Check deadline
  if (new Date() > new Date(DEADLINE + 'T23:59:59')) {
    stepLookup.classList.add('hidden');
    stepClosed.classList.remove('hidden');
  }

  function showStep(step: HTMLElement) {
    [stepLookup, stepRespond, stepSuccess, stepError, stepClosed].forEach((s) => s.classList.add('hidden'));
    step.classList.remove('hidden');
  }

  // === Autocomplete ===
  function renderListbox(query: string) {
    const matches = findHouseholds(HOUSEHOLDS, query);
    listbox.innerHTML = '';
    if (matches.length === 0) {
      listbox.classList.add('hidden');
      searchInput.setAttribute('aria-expanded', 'false');
      return;
    }
    matches.forEach((m, i) => {
      const li = document.createElement('li');
      li.id = `guest-option-${i}`;
      li.role = 'option';
      li.setAttribute('aria-selected', 'false');
      li.className = 'cursor-pointer px-5 py-3 font-body text-[1rem] text-navy hover:bg-coral/10 transition-colors';
      li.textContent = m.household.displayName;
      if (m.matchedOn !== m.household.displayName) {
        const badge = document.createElement('span');
        badge.className = 'ml-2 text-[0.8rem] text-text-muted';
        badge.textContent = `(${m.matchedOn})`;
        li.appendChild(badge);
      }
      if (m.household.members.length > 1) {
        const count = document.createElement('span');
        count.className = 'ml-2 text-[0.8rem] text-text-muted';
        count.textContent = `· party of ${m.household.members.length}`;
        li.appendChild(count);
      }
      li.addEventListener('click', () => selectHousehold(m.household));
      listbox.appendChild(li);
    });
    listbox.classList.remove('hidden');
    searchInput.setAttribute('aria-expanded', 'true');
    activeIndex = -1;
  }

  function setActiveDescendant(index: number) {
    const items = listbox.querySelectorAll('[role="option"]');
    items.forEach((item, i) => {
      if (i === index) {
        item.setAttribute('aria-selected', 'true');
        item.classList.add('bg-coral/10');
        searchInput.setAttribute('aria-activedescendant', item.id);
        item.scrollIntoView({ block: 'nearest' });
      } else {
        item.setAttribute('aria-selected', 'false');
        item.classList.remove('bg-coral/10');
      }
    });
  }

  searchInput.addEventListener('input', () => renderListbox(searchInput.value));

  searchInput.addEventListener('keydown', (e) => {
    const items = listbox.querySelectorAll('[role="option"]');
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      activeIndex = Math.min(activeIndex + 1, items.length - 1);
      setActiveDescendant(activeIndex);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      activeIndex = Math.max(activeIndex - 1, 0);
      setActiveDescendant(activeIndex);
    } else if (e.key === 'Enter' && activeIndex >= 0) {
      e.preventDefault();
      const matches = findHouseholds(HOUSEHOLDS, searchInput.value);
      if (matches[activeIndex]) selectHousehold(matches[activeIndex].household);
    } else if (e.key === 'Escape') {
      listbox.classList.add('hidden');
      searchInput.setAttribute('aria-expanded', 'false');
    }
  });

  document.addEventListener('click', (e) => {
    if (!stepLookup.contains(e.target as Node)) {
      listbox.classList.add('hidden');
      searchInput.setAttribute('aria-expanded', 'false');
    }
  });

  function selectHousehold(household: Household) {
    selectedHousehold = household;
    formState = initFormState(household);
    searchInput.value = household.displayName;
    listbox.classList.add('hidden');
    searchInput.setAttribute('aria-expanded', 'false');

    householdDisplayName.textContent = household.displayName;
    renderMemberRows();
    validationSummary.classList.add('hidden');
    showStep(stepRespond);
  }

  // === Per-member rows ===
  function renderMemberRows() {
    memberRows.innerHTML = '';
    const mealOptions = MEALS.map((m) => `<option value="${escapeHtml(m.id)}">${escapeHtml(m.label)}</option>`).join('');

    formState.forEach((member) => {
      const row = document.createElement('div');
      row.className = 'rounded-xl border border-light-gray bg-white p-5';
      row.dataset.memberId = member.memberId;

      const yesId = `attend-yes-${member.memberId}`;
      const noId = `attend-no-${member.memberId}`;
      const mealId = `meal-${member.memberId}`;

      row.innerHTML = `
        <p class="mb-3 font-ui text-[0.95rem] font-semibold text-navy">${escapeHtml(member.name)}</p>
        <fieldset>
          <legend class="sr-only">Will ${escapeHtml(member.name)} attend?</legend>
          <div class="grid grid-cols-2 gap-3">
            <button
              type="button"
              role="radio"
              id="${yesId}"
              aria-checked="${member.attending === 'yes'}"
              data-member="${escapeHtml(member.memberId)}"
              data-value="yes"
              class="member-attend-btn flex min-h-12 items-center justify-center rounded-lg border-2 ${member.attending === 'yes' ? 'border-coral bg-coral/10 text-coral' : 'border-light-gray bg-white text-navy'} font-ui text-[0.9rem] font-semibold transition-all hover:border-coral hover:bg-coral/5"
            >Attending</button>
            <button
              type="button"
              role="radio"
              id="${noId}"
              aria-checked="${member.attending === 'no'}"
              data-member="${escapeHtml(member.memberId)}"
              data-value="no"
              class="member-attend-btn flex min-h-12 items-center justify-center rounded-lg border-2 ${member.attending === 'no' ? 'border-coral bg-coral/10 text-coral' : 'border-light-gray bg-white text-navy'} font-ui text-[0.9rem] font-semibold transition-all hover:border-coral hover:bg-coral/5"
            >Not attending</button>
          </div>
        </fieldset>
        <div class="meal-wrapper mt-4 ${member.attending === 'yes' ? '' : 'hidden'}">
          <label for="${mealId}" class="mb-1 block font-ui text-[0.85rem] font-semibold text-navy">Meal choice</label>
          <select
            id="${mealId}"
            data-member="${escapeHtml(member.memberId)}"
            class="member-meal-select w-full rounded-lg border-2 border-light-gray bg-white px-4 py-3 font-body text-[1rem] text-navy focus:border-coral focus:outline-none"
          >
            <option value="">Select a meal…</option>
            ${mealOptions}
          </select>
        </div>
      `;

      const select = row.querySelector('.member-meal-select') as HTMLSelectElement;
      if (member.meal) select.value = member.meal;

      memberRows.appendChild(row);
    });

    memberRows.querySelectorAll('.member-attend-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const memberId = (btn as HTMLElement).dataset.member!;
        const value = (btn as HTMLElement).dataset.value as 'yes' | 'no';
        formState = setAttendance(formState, memberId, value);
        renderMemberRows();
      });
    });

    memberRows.querySelectorAll('.member-meal-select').forEach((sel) => {
      sel.addEventListener('change', () => {
        const memberId = (sel as HTMLElement).dataset.member!;
        formState = setMeal(formState, memberId, (sel as HTMLSelectElement).value);
      });
    });
  }

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  // === Submission ===
  let lastPayload: ReturnType<typeof toSubmitPayload> | null = null;

  async function submitRsvp() {
    if (!selectedHousehold) return;

    const v = validate(formState);
    if (!v.ok) {
      validationSummary.textContent = v.reasons[0];
      validationSummary.classList.remove('hidden');
      return;
    }
    validationSummary.classList.add('hidden');

    const dietary = (document.getElementById('dietary-needs') as HTMLTextAreaElement).value.trim();
    const note = (document.getElementById('note') as HTMLTextAreaElement).value.trim();
    const payload = toSubmitPayload(selectedHousehold, formState, {
      dietaryNeeds: dietary || undefined,
      note: note || undefined,
    });
    lastPayload = payload;

    submitBtn.setAttribute('disabled', '');
    const originalText = submitBtn.textContent;
    submitBtn.innerHTML = `
      <svg class="mr-2 h-5 w-5 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
      </svg>
      Sending…
    `;

    const yesCount = attendingCount(formState);
    const noCount = decliningCount(formState);

    try {
      const resp = await fetch('/api/rsvp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = (await resp.json()) as { success: boolean; message: string };

      if (result.success) {
        if (yesCount > 0 && noCount === 0) {
          successHeading.textContent = 'Thank you!';
          successMessage.textContent = `We can't wait to celebrate with all ${yesCount} of you.`;
        } else if (yesCount > 0 && noCount > 0) {
          successHeading.textContent = 'Got it!';
          successMessage.textContent = `Got it: ${yesCount} attending, ${noCount} can't make it. We'll miss them and can't wait to see you.`;
        } else {
          successHeading.textContent = "We'll miss you!";
          successMessage.textContent = 'Thanks for letting us know.';
        }
        danceReveal.classList.toggle('hidden', yesCount === 0);
        showStep(stepSuccess);
      } else {
        errorMessage.textContent = result.message;
        showStep(stepError);
      }
    } catch {
      errorMessage.textContent = 'Network error. Please check your connection and try again.';
      showStep(stepError);
    } finally {
      submitBtn.removeAttribute('disabled');
      submitBtn.textContent = originalText;
    }
  }

  submitBtn.addEventListener('click', submitRsvp);

  retryBtn.addEventListener('click', () => {
    if (lastPayload) showStep(stepRespond);
    else showStep(stepLookup);
  });
</script>
