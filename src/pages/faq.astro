---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Accordion from '../components/Accordion.astro';
import faqData from '../data/faq.json';
---

<BaseLayout title="FAQ" description="Frequently asked questions about the wedding">
  <Navigation slot="header" />

  <!-- Page Header -->
  <section class="bg-gradient-to-b from-primary-50 to-white px-4 py-12 text-center">
    <h1 class="font-display text-4xl text-neutral-900 md:text-5xl">Frequently Asked Questions</h1>
    <p class="mt-4 text-neutral-600">Everything you might want to know about our big day</p>
  </section>

  <!-- FAQ Accordion -->
  <section class="px-4 py-12" aria-labelledby="faq-heading">
    <div class="mx-auto max-w-2xl">
      <h2 id="faq-heading" class="sr-only">Questions and Answers</h2>
      <Accordion items={faqData.faqs} />
    </div>
  </section>

  <!-- Still have questions? -->
  <section class="bg-primary-50 px-4 py-12 text-center">
    <div class="mx-auto max-w-2xl">
      <h2 class="font-display text-2xl text-neutral-900 md:text-3xl">Still have questions?</h2>
      <p class="mt-4 text-neutral-700">
        We're happy to help! Reach out to us directly and we'll get back to you as soon as possible.
      </p>
      <a
        href="mailto:wedding@example.com"
        class="touch-target mt-6 inline-flex items-center gap-2 rounded-md bg-primary-500 px-6 py-3 text-white transition-colors hover:bg-primary-600 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        Contact Us
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
