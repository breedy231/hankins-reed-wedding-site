---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Travel" description="Travel and accommodation information">
  <Navigation slot="header" />

  <section class="mx-auto max-w-2xl px-4 py-12 text-center">
    <h1 class="font-display text-3xl text-neutral-900 md:text-4xl">Travel</h1>
    <p class="mt-6 text-neutral-600">Coming soon...</p>
  </section>

  <Footer slot="footer" />
</BaseLayout>
