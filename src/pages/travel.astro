---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import HotelCard from '../components/HotelCard.astro';
import hotelsData from '../data/hotels.json';
---

<BaseLayout title="Travel" description="Travel information, hotels, and getting to Chicago for the wedding">
  <Navigation slot="header" />

  <!-- Page Header -->
  <section class="bg-gradient-to-b from-primary-50 to-white px-4 py-12 text-center">
    <h1 class="font-display text-4xl text-neutral-900 md:text-5xl">Travel</h1>
    <p class="mt-4 text-neutral-600">Everything you need to plan your trip to Chicago</p>
  </section>

  <!-- Getting to Chicago -->
  <section class="px-4 py-12" aria-labelledby="airports-heading">
    <div class="mx-auto max-w-4xl">
      <h2 id="airports-heading" class="mb-8 text-center font-display text-3xl text-neutral-900">Getting to Chicago</h2>

      <div class="grid gap-6 md:grid-cols-2">
        <!-- O'Hare -->
        <div class="rounded-lg border border-neutral-200 bg-white p-6 shadow-sm">
          <h3 class="text-xl font-semibold text-neutral-900">O'Hare International Airport (ORD)</h3>
          <p class="mt-2 text-neutral-600">Chicago's largest airport with the most flight options.</p>
          <ul class="mt-4 space-y-2 text-neutral-600">
            <li class="flex items-start gap-2">
              <svg class="mt-1 h-4 w-4 flex-shrink-0 text-primary-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>~45 min to downtown by CTA Blue Line</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="mt-1 h-4 w-4 flex-shrink-0 text-primary-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>~30-45 min by rideshare/taxi</span>
            </li>
          </ul>
        </div>

        <!-- Midway -->
        <div class="rounded-lg border border-neutral-200 bg-white p-6 shadow-sm">
          <h3 class="text-xl font-semibold text-neutral-900">Midway International Airport (MDW)</h3>
          <p class="mt-2 text-neutral-600">Closer to downtown, served primarily by Southwest.</p>
          <ul class="mt-4 space-y-2 text-neutral-600">
            <li class="flex items-start gap-2">
              <svg class="mt-1 h-4 w-4 flex-shrink-0 text-primary-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>~25 min to downtown by CTA Orange Line</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="mt-1 h-4 w-4 flex-shrink-0 text-primary-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>~20-30 min by rideshare/taxi</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Hotels -->
  <section class="bg-neutral-100 px-4 py-12" aria-labelledby="hotels-heading">
    <div class="mx-auto max-w-4xl">
      <h2 id="hotels-heading" class="mb-4 text-center font-display text-3xl text-neutral-900">Where to Stay</h2>
      <p class="mb-8 text-center text-neutral-600">
        We've compiled some nearby hotel options. Room blocks coming soon!
      </p>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          hotelsData.hotels.map((hotel) => (
            <HotelCard
              name={hotel.name}
              address={hotel.address}
              priceRange={hotel.priceRange}
              distance={hotel.distance}
              bookingUrl={hotel.bookingUrl ?? undefined}
              blockCode={hotel.blockCode ?? undefined}
              blockDeadline={hotel.blockDeadline ?? undefined}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Parking -->
  <section class="px-4 py-12" aria-labelledby="parking-heading">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="parking-heading" class="mb-4 font-display text-3xl text-neutral-900">Parking</h2>
      <p class="text-neutral-700">
        Parking information will be updated closer to the wedding date. Many downtown Chicago hotels offer valet
        parking, and there are several public parking garages near the venue.
      </p>
      <p class="mt-4 text-neutral-700">
        We recommend using rideshare services (Uber/Lyft) if you plan on enjoying the open bar!
      </p>
    </div>
  </section>

  <!-- Chicago Tips -->
  <section class="bg-primary-50 px-4 py-12" aria-labelledby="tips-heading">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="tips-heading" class="mb-4 font-display text-3xl text-neutral-900">While You're in Town</h2>
      <p class="text-neutral-700">
        Make a weekend of it! Chicago has world-class dining, architecture, museums, and entertainment. Some of our
        favorites:
      </p>
      <ul class="mt-4 text-left text-neutral-700">
        <li class="flex items-start gap-2 py-1">
          <span class="text-primary-500">&bull;</span>
          <span>Architecture boat tour on the Chicago River</span>
        </li>
        <li class="flex items-start gap-2 py-1">
          <span class="text-primary-500">&bull;</span>
          <span>Deep dish pizza at Lou Malnati's or Pequod's</span>
        </li>
        <li class="flex items-start gap-2 py-1">
          <span class="text-primary-500">&bull;</span>
          <span>Art Institute of Chicago</span>
        </li>
        <li class="flex items-start gap-2 py-1">
          <span class="text-primary-500">&bull;</span>
          <span>Walk along the Riverwalk or Lakefront Trail</span>
        </li>
      </ul>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
