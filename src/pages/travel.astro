---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import HotelCard from '../components/HotelCard.astro';
import hotelsData from '../data/hotels.json';
---

<BaseLayout title="Travel" description="Travel information, hotels, and getting to Chicago for the wedding">
  <Navigation slot="header" />

  <Hero title="Where to Stay" subtitle="Hotel blocks and getting around" />

  <!-- Hotels -->
  <section class="px-6 py-24" aria-labelledby="hotels-heading">
    <div class="mx-auto max-w-4xl">
      <h2 id="hotels-heading" class="mb-4 text-center font-display text-[2.2rem] font-normal text-navy">Hotel Block</h2>
      <p class="mb-12 text-center text-text-muted">
        We've reserved room blocks at these hotels for our wedding weekend.
      </p>

      <div class="grid gap-6 md:grid-cols-2">
        {
          hotelsData.hotels.map((hotel) => (
            <HotelCard
              name={hotel.name}
              address={hotel.address}
              distance={hotel.distance}
              bookingUrl={hotel.bookingUrl ?? undefined}
              blockCode={hotel.blockCode ?? undefined}
              blockDeadline={hotel.blockDeadline ?? undefined}
              phone={(hotel as any).phone ?? undefined}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Getting to Chicago -->
  <section class="bg-light-cream px-6 py-24" aria-labelledby="airports-heading">
    <div class="mx-auto max-w-4xl">
      <h2 id="airports-heading" class="mb-12 text-center font-display text-[2.2rem] font-normal text-navy">Getting to Chicago</h2>

      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl bg-white p-8">
          <h3 class="font-display text-[1.3rem] font-semibold text-navy">O'Hare International (ORD)</h3>
          <p class="mt-2 text-text-muted">Chicago's largest airport with the most flight options.</p>
          <ul class="mt-4 space-y-2 text-text-muted">
            <li class="flex items-start gap-2">
              <span class="mt-1 text-coral">&#10003;</span>
              <span>~45 min to downtown by CTA Blue Line</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1 text-coral">&#10003;</span>
              <span>~30-45 min by rideshare/taxi</span>
            </li>
          </ul>
        </div>

        <div class="rounded-2xl bg-white p-8">
          <h3 class="font-display text-[1.3rem] font-semibold text-navy">Midway International (MDW)</h3>
          <p class="mt-2 text-text-muted">Closer to downtown, served primarily by Southwest.</p>
          <ul class="mt-4 space-y-2 text-text-muted">
            <li class="flex items-start gap-2">
              <span class="mt-1 text-coral">&#10003;</span>
              <span>~25 min to downtown by CTA Orange Line</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1 text-coral">&#10003;</span>
              <span>~20-30 min by rideshare/taxi</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Transportation -->
  <section class="px-6 py-24" aria-labelledby="transport-heading">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="transport-heading" class="font-display text-[2.2rem] font-normal text-navy">Getting Around</h2>
      <p class="mt-4 text-navy">
        We recommend rideshare services (Uber/Lyft) or CTA to get to the venue.
        Complimentary shuttles will run from the venue back to the hotel block throughout the evening and after the last dance.
        Chicago's CTA trains are also fast and affordable — grab a Ventra card at any station.
      </p>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
