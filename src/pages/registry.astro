---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="Registry" description="Gift registry information for Brendan & Scott's wedding">
  <Navigation slot="header" />

  <Hero title="Registry" subtitle="A few places we're registered" />

  <!-- Registry intro -->
  <section class="px-6 py-24" aria-labelledby="registry-heading">
    <div class="mx-auto max-w-2xl">
      <h2 id="registry-heading" class="sr-only">Gift Registry</h2>
      <p class="text-center leading-[1.7] text-navy">
        Your presence is the greatest gift. For those who wish to honor us with a gift, we're registered at the following stores.
      </p>

      <!-- Registry cards -->
      <div class="mt-12 space-y-6">
        <!-- Crate & Barrel -->
        <div class="rounded-2xl border-2 border-transparent bg-white p-8 text-center shadow-sm transition-all hover:-translate-y-1 hover:border-coral hover:shadow-md">
          <h3 class="font-display text-[1.5rem] font-semibold text-navy">Crate & Barrel</h3>
          <p class="mt-3 leading-[1.7] text-text-muted">
            Home essentials and modern furnishings for our new life together.
          </p>
          <a
            href="https://www.crateandbarrel.com/gift-registry/brendan-reed-and-scott-hankins/r7506513"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-block rounded-full bg-coral px-8 py-3 font-ui text-[0.95rem] font-semibold uppercase tracking-[1px] text-white transition-all hover:-translate-y-0.5 hover:bg-coral-dark"
          >
            View Registry <span class="ml-1 inline-block">&#8594;</span>
          </a>
        </div>

        <!-- Williams-Sonoma -->
        <div class="rounded-2xl border-2 border-transparent bg-white p-8 text-center shadow-sm transition-all hover:-translate-y-1 hover:border-coral hover:shadow-md">
          <h3 class="font-display text-[1.5rem] font-semibold text-navy">Williams-Sonoma</h3>
          <p class="mt-3 leading-[1.7] text-text-muted">
            Kitchen and entertaining essentials for hosting friends and family.
          </p>
          <a
            href="https://www.williams-sonoma.com/registry/b86cjcs5vh/registry-list.html"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-block rounded-full bg-coral px-8 py-3 font-ui text-[0.95rem] font-semibold uppercase tracking-[1px] text-white transition-all hover:-translate-y-0.5 hover:bg-coral-dark"
          >
            View Registry <span class="ml-1 inline-block">&#8594;</span>
            <span class="sr-only">(opens in new tab)</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
