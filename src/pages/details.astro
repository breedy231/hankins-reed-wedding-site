---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import venuesData from '../data/venues.json';

function formatTime(time24: string): string {
  const [hours, minutes] = time24.split(':').map(Number);
  const period = hours >= 12 ? 'PM' : 'AM';
  const hours12 = hours % 12 || 12;
  return `${hours12}:${minutes.toString().padStart(2, '0')} ${period}`;
}

const timelineEvents = [
  {
    time: formatTime(venuesData.ceremony.time),
    title: 'Ceremony',
    description: 'Please be seated 15 minutes prior',
  },
  {
    time: formatTime(venuesData.cocktails.time),
    title: 'Cocktail Hour',
    description: 'Drinks and appetizers',
  },
  {
    time: '6:00 PM',
    title: 'Reception',
    description: 'Dinner, dancing, and celebration',
  },
  {
    time: '11:00 PM',
    title: 'Last Dance',
    description: 'End of the evening',
  },
];
---

<BaseLayout title="Details" description="Wedding day schedule, venue information, and what to expect">
  <Navigation slot="header" />

  <Hero title="The Details" subtitle="Everything you need to know about our day" />

  <!-- Timeline -->
  <section class="px-6 py-24" aria-labelledby="schedule-heading">
    <div class="mx-auto max-w-4xl">
      <h2 id="schedule-heading" class="mb-12 text-center font-display text-[2.2rem] font-normal text-navy">Schedule</h2>
      <Timeline events={timelineEvents} />
    </div>
  </section>

  <!-- Venue -->
  <section class="bg-light-cream px-6 py-24" aria-labelledby="venue-heading">
    <div class="mx-auto max-w-4xl text-center">
      <h2 id="venue-heading" class="font-display text-[2.2rem] font-normal text-navy">{venuesData.ceremony.name}</h2>
      <p class="mt-2 text-text-muted">{venuesData.ceremony.neighborhood}</p>

      <address class="mt-6 text-[1.1rem] not-italic text-navy">
        {venuesData.ceremony.address}
      </address>

      <a
        href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(venuesData.ceremony.address)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-block rounded-full bg-coral px-6 py-3 font-ui text-[0.95rem] font-semibold uppercase tracking-[1px] text-white transition-all hover:-translate-y-0.5 hover:bg-coral-dark"
      >
        View on Map
        <span class="sr-only">(opens in new tab)</span>
      </a>
    </div>
  </section>

  <!-- Dress Code -->
  <section class="px-6 py-24" aria-labelledby="dresscode-heading">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="dresscode-heading" class="font-display text-[2.2rem] font-normal text-navy">Dress Code</h2>
      <p class="mt-4 font-display text-[1.5rem] text-coral">Cocktail Attire</p>
      <p class="mt-4 text-text-muted">
        Suits, dresses, or dressy separates all work well. Skip the jeans and flip-flops, but no need for a tuxedo or ballgown.
      </p>
    </div>
  </section>

  <!-- Getting There -->
  <section class="bg-light-cream px-6 py-24" aria-labelledby="getting-there-heading">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="getting-there-heading" class="font-display text-[2.2rem] font-normal text-navy">Getting There</h2>
      <p class="mt-4 text-navy">
        Street parking in Fulton Market is limited. We recommend rideshare services for the easiest arrival and safest departure.
      </p>
      <div class="mt-8 space-y-4 text-left">
        <div class="rounded-2xl bg-white p-6">
          <h3 class="font-display text-[1.3rem] font-semibold text-navy">Rideshare</h3>
          <p class="mt-2 text-text-muted">Uber and Lyft are the easiest way to get to and from the venue. Drop-off is right at the front entrance.</p>
        </div>
        <div class="rounded-2xl bg-white p-6">
          <h3 class="font-display text-[1.3rem] font-semibold text-navy">Parking</h3>
          <p class="mt-2 text-text-muted">There are several public parking garages nearby. Street parking is available but can fill up quickly on weekends.</p>
        </div>
        <div class="rounded-2xl bg-white p-6">
          <h3 class="font-display text-[1.3rem] font-semibold text-navy">Public Transit</h3>
          <p class="mt-2 text-text-muted">The venue is accessible via CTA Green and Pink lines (Ashland stop) or several bus routes along Ogden Avenue.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Weather -->
  <section class="px-6 py-24" aria-labelledby="weather-heading">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="weather-heading" class="font-display text-[2.2rem] font-normal text-navy">Chicago in September</h2>
      <p class="mt-4 text-navy">
        September in Chicago typically offers pleasant weather with temperatures between 55&deg;F and 75&deg;F.
        We recommend bringing a light layer for the evening.
      </p>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
